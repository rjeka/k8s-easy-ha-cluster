---
extends: default
ignore: |
  collections/
  inventory/*/artifacts/
  # Claude workflows are maintained upstream (anthropics/claude-code-action)
  .github/workflows/claude*.yml
rules:
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
